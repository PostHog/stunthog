{
  "name": "stunthog",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "stunthog": "dist/cli.js"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch src/cli.ts serve --no-open",
    "dev:web": "bunx vite --config web/vite.config.ts",
    "start": "bun dist/cli.js serve",
    "build": "bun scripts/build.ts",
    "compile": "bun run build && bun scripts/compile.ts",
    "compile:binary": "bun scripts/compile.ts",
    "package:npm": "bun scripts/package-npm.ts",
    "db:generate": "bunx prisma generate",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p web/tsconfig.json --noEmit",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write .",
    "test": "bun test test/*.test.ts web/test/*.test.tsx",
    "test:web": "bun test web/test/*.test.tsx",
    "check": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "@aliou/sh": "0.4.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@posthog/icons": "0.40.0",
    "@posthog/quill": "0.3.0-beta.33",
    "@posthog/react": "^1.11.3",
    "@prisma/client": "6.19.3",
    "@uiw/react-codemirror": "^4.25.12",
    "chalk": "6.0.0",
    "diff": "8.0.4",
    "dompurify": "3.4.17",
    "dotenv": "17.4.2",
    "fuse.js": "^7.5.0",
    "marked": "18.0.11",
    "nest-commander": "3.21.0",
    "open": "10.2.0",
    "p-limit": "6.2.0",
    "posthog-js": "^1.447.15",
    "posthog-node": "^6.0.5",
    "re2js": "2.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typebox": "1.3.27",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^29.1.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/chord": "1.1.0",
    "ws": "8.22.0"
  }
}
